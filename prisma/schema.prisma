  firstName          String                /// @phi
  middleName         String?               /// @phi
  lastName           String                /// @phi
  suffix             String?               /// @phi
  preferredName      String?               /// @phi
  previousNames      Json?                 /// @phi
  birthDate          DateTime              @db.Date /// @phi
  administrativeGender AdministrativeGender
  sexForClinicalUse  SexForClinicalUse?
  genderIdentity     String?               /// @phi SNOMED/HL7 code
  pronouns           String?
  sexualOrientation  String?               /// @phi
  raceCodes          String[]              /// @phi CDC Race & Ethnicity codes (OMB + detailed)
  ethnicityCodes     String[]              /// @phi
  preferredLanguage  String?               /// BCP-47
  interpreterNeeded  Boolean               @default(false)
  ssnCiphertext      Bytes?                /// @phi @encrypted @secret
  ssnLast4           String?               /// @phi
  maritalStatus      String?
  deceasedAt         DateTime?             /// @phi
  photoFileId        String?               @db.Uuid
  pcpPractitionerId  String?               @db.Uuid
  preferredPharmacyId String?              @db.Uuid
  preferredPharmacy  Pharmacy?             @relation(fields: [preferredPharmacyId], references: [id])
  guarantorRelatedPersonId String?         @db.Uuid /// null = self
  codeStatus         String?               /// full-code, dnr, dni, polst
  advanceDirectiveDocumentId String?       @db.Uuid
  securityLabels     String[]              /// patient-level restrictions, e.g. VIP, confidential
  allergiesReviewedAt DateTime?            /// @server
  noKnownAllergies   Boolean               @default(false)
  medsReconciledAt   DateTime?             /// @server
  medsReconciledById String?               @db.Uuid /// @server
  historyReviewedAt  DateTime?             /// @server
  mergedIntoId       String?               @db.Uuid /// @server set when this record was merged (never deleted, INV-ID-04)
  active             Boolean               @default(true)
  version            Int                   @default(1) /// @server
  createdAt          DateTime              @default(now()) /// @server
  updatedAt          DateTime              @updatedAt /// @server
  createdById        String?               @db.Uuid /// @server

  identifiers        PatientIdentifier[]
  addresses          PatientAddress[]
  contactPoints      PatientContactPoint[]
  relatedPersons     RelatedPerson[]
  coverages          Coverage[]
  appointments       Appointment[]
  encounters         Encounter[]
  conditions         Condition[]
  allergies          AllergyIntolerance[]
  medicationStatements MedicationStatement[]
  medicationRequests MedicationRequest[]
  observations       Observation[]
  diagnosticReports  DiagnosticReport[]
  immunizations      Immunization[]
  procedures         Procedure[]
  familyHistory      FamilyMemberHistory[]
  questionnaireResponses QuestionnaireResponse[]
  serviceRequests    ServiceRequest[]
  referrals          Referral[]
  documents          DocumentReference[]
  consents           Consent[]
  messageThreads     MessageThread[]
  communications     CommunicationLog[]
  tasks              Task[]
  careGaps           CareGap[]
  carePlans          CarePlan[]
  goals              Goal[]
  timeLogs           TimeLog[]
  devices            Device[]
  chargeItems        ChargeItem[]
  claims             Claim[]
  ledgerEntries      LedgerEntry[]
  payments           Payment[]
  paymentMethods     PaymentMethod[]
  paymentPlans       PaymentPlan[]
  statements         Statement[]
  estimates          Estimate[]
  stagedChanges      StagedChange[]
  emergencyAccess    EmergencyAccessGrant[]
  disclosures        DisclosureLog[]
  portalAccess       PortalAccess[]
  waitlistEntries    WaitlistEntry[]
  recalls            Recall[]
  amendmentRequests  AmendmentRequest[]
  avs                AfterVisitSummary[]
  checkins           CheckinSession[]
  authorizations     Authorization[]
  rxRequests         RxRequest[]
  eVisits            EVisit[]

  @@unique([practiceId, mrn])
  @@index([practiceId, lastName, firstName, birthDate])
  @@index([practiceId, birthDate])
}

/// MRN history, external ids (lab, HIE, payer member ids are on Coverage)
/// @tenant
model PatientIdentifier {
