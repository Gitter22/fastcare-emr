  email         String?  /// @phi
  address       Json?    /// @phi
  ssnCiphertext Bytes?   /// @phi @encrypted @secret guarantor SSN for collections only
  active        Boolean  @default(true)
}

/// Possible duplicate pairs for review (INV-ID-02)
/// @tenant
model DuplicateCandidate {
