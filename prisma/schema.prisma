  modifiers    String[]
  units        Decimal    @db.Decimal(8, 2)
  charge       Decimal    @db.Decimal(10, 2)
  dxPointers   String[]   /// A–L
  icd10Codes   String[]   /// resolved codes in pointer order
}

/// 999 / 277CA / 276-277 / 835 events and notes
/// @tenant
/// @append-only
model ClaimEvent {
  id           String         @id @default(uuid()) @db.Uuid
  practiceId   String         @db.Uuid /// @server
  claimId      String         @db.Uuid
  claim        Claim          @relation(fields: [claimId], references: [id])
  type         ClaimEventType
  statusCode   String?        /// e.g. 277CA category/status codes
  description  String?
  raw          Json?
  interfaceMessageId String?  @db.Uuid
  at           DateTime       @default(now())
}

/// @tenant
model ClaimBatch {
  id           String    @id @default(uuid()) @db.Uuid
  practiceId   String    @db.Uuid /// @server
  claimCount   Int
  submittedAt  DateTime
  interchangeControlNumber String?
  interfaceMessageId String? @db.Uuid
  status       String    /// submitted, accepted, rejected
}

/// 835 remittance (ERA) received from Stedi
/// @tenant
/// @fhir PaymentReconciliation
model Remittance {
  id             String           @id @default(uuid()) @db.Uuid
  practiceId     String           @db.Uuid /// @server
  payerId        String           @db.Uuid
  payer          Payer            @relation(fields: [payerId], references: [id])
  eftTraceNumber String
  paymentMethod  String           /// ACH, CHK, NON
  paymentAmount  Decimal          @db.Decimal(12, 2)
  paymentDate    DateTime         @db.Date
  receivedAt     DateTime         @default(now()) /// @server
  status         RemittanceStatus @default(RECEIVED) /// @server
  depositMatched Boolean          @default(false) /// @server
  rawFileId      String?          @db.Uuid /// @server
  postedById     String?          @db.Uuid /// @server
  postedAt       DateTime?        /// @server

  claimPayments  RemittanceClaimPayment[]
  providerAdjustments ProviderLevelAdjustment[]

  @@unique([practiceId, payerId, eftTraceNumber])
}

/// @tenant
model RemittanceClaimPayment {
  id             String     @id @default(uuid()) @db.Uuid
  practiceId     String     @db.Uuid /// @server
  remittanceId   String     @db.Uuid
  remittance     Remittance @relation(fields: [remittanceId], references: [id])
  claimId        String?    @db.Uuid /// null = unmatched (exception)
  claim          Claim?     @relation(fields: [claimId], references: [id])
  payerClaimControlNumber String?
  patientControlNumber String
  billed         Decimal    @db.Decimal(10, 2)
  allowed        Decimal?   @db.Decimal(10, 2)
  paid           Decimal    @db.Decimal(10, 2)
  patientResponsibility Decimal @db.Decimal(10, 2)
  claimStatusCode String    /// 1 primary, 4 denied, 22 reversal …
  underpaidBy    Decimal?   @db.Decimal(10, 2) /// @server vs contract fee schedule
  posted         Boolean    @default(false) /// @server

  adjustments    RemittanceAdjustment[]
}

/// CARC/RARC adjustments per claim or line
/// @tenant
model RemittanceAdjustment {
  id              String                 @id @default(uuid()) @db.Uuid
  practiceId      String                 @db.Uuid /// @server
  claimPaymentId  String                 @db.Uuid
  claimPayment    RemittanceClaimPayment @relation(fields: [claimPaymentId], references: [id])
  lineNumber      Int?
  group           AdjustmentGroup
  carc            String
  rarc            String[]
  amount          Decimal                @db.Decimal(10, 2)
}

/// PLB segment (recoupments, interest)
/// @tenant
model ProviderLevelAdjustment {
  id             String     @id @default(uuid()) @db.Uuid
  practiceId     String     @db.Uuid /// @server
  remittanceId   String     @db.Uuid
  remittance     Remittance @relation(fields: [remittanceId], references: [id])
  reasonCode     String     /// WO, L6, FB …
  reference      String?    /// source claim reference
  amount         Decimal    @db.Decimal(10, 2)
  postedToClaimId String?   @db.Uuid /// @server
}

/// @tenant
model Denial {
  id           String       @id @default(uuid()) @db.Uuid
  practiceId   String       @db.Uuid /// @server
  claimId      String       @db.Uuid
  claim        Claim        @relation(fields: [claimId], references: [id])
  carc         String
  rarc         String[]
  rootCause    String       /// @server grouping key (no-auth, medical-necessity, cob, underpaid, …)
  amount       Decimal      @db.Decimal(10, 2)
  appealDeadline DateTime   @db.Date /// @server INV-FIN-05
  status       DenialStatus @default(OPEN)
  action       DenialAction?
  snoozedUntil DateTime?
  taskId       String?      @db.Uuid /// @server
  createdAt    DateTime     @default(now()) /// @server

  appeals      Appeal[]
}

/// @tenant
model Appeal {
  id            String   @id @default(uuid()) @db.Uuid
  practiceId    String   @db.Uuid /// @server
  denialId      String   @db.Uuid
  denial        Denial   @relation(fields: [denialId], references: [id])
  level         Int      @default(1)
  letterFileId  String   @db.Uuid
  attachmentFileIds String[] @db.Uuid
  submittedVia  String   /// payer-portal, fax, mail, x12-275
  submittedAt   DateTime
  outcome       String?
  submittedById String   @db.Uuid /// @server
}

/// Append-only financial ledger; balances are derived (INV-FIN-01, INV-FIN-02)
/// @tenant
/// @append-only
model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  practiceId     String          @db.Uuid /// @server
  patientId      String          @db.Uuid
  patient        Patient         @relation(fields: [patientId], references: [id])
  guarantorId    String?         @db.Uuid
  encounterId    String?         @db.Uuid
  chargeItemId   String?         @db.Uuid
  claimId        String?         @db.Uuid
  paymentId      String?         @db.Uuid
  remittanceId   String?         @db.Uuid
  type           LedgerEntryType
  responsibility Responsibility
  amount         Decimal         @db.Decimal(12, 2) /// positive increases what is owed, negative reduces
  carc           String?
  reversalOfId   String?         @db.Uuid
  depositBatchId String?         @db.Uuid
  memo           String?
  postedAt       DateTime        @default(now())
  postedById     String?         @db.Uuid

  @@index([patientId, postedAt])
  @@index([encounterId])
}

/// Tokenised card on file (no PAN stored; PCI scope stays with the payment processor)
/// @tenant
model PaymentMethod {
  id             String   @id @default(uuid()) @db.Uuid
  practiceId     String   @db.Uuid /// @server
  patientId      String   @db.Uuid
  patient        Patient  @relation(fields: [patientId], references: [id])
  processorToken String   /// @secret
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  consentId      String?  @db.Uuid /// card-on-file consent
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) /// @server
}

/// @tenant
/// @fhir PaymentNotice
model Payment {
  id              String            @id @default(uuid()) @db.Uuid
  practiceId      String            @db.Uuid /// @server
  patientId       String            @db.Uuid
  patient         Patient           @relation(fields: [patientId], references: [id])
  method          PaymentMethodType
  paymentMethodId String?           @db.Uuid
  amount          Decimal           @db.Decimal(10, 2)
  status          PaymentStatus     @default(PENDING) /// @server
  processorRef    String?           /// @server
  checkNumber     String?
  appliedTo       Json?             /// [{encounterId, amount}]
  channel         String            /// front-desk, portal, autopay, mail
  locationId      String?           @db.Uuid
  receiptChannel  String?
  depositBatchId  String?           @db.Uuid /// @server
  takenById       String?           @db.Uuid /// @server
  takenAt         DateTime          @default(now()) /// @server
  refundOfId      String?           @db.Uuid
}

/// @tenant
model PaymentPlan {
  id             String     @id @default(uuid()) @db.Uuid
  practiceId     String     @db.Uuid /// @server
  patientId      String     @db.Uuid
  patient        Patient    @relation(fields: [patientId], references: [id])
  totalAmount    Decimal    @db.Decimal(10, 2)
  months         Int
  monthlyAmount  Decimal    @db.Decimal(10, 2)
  firstPaymentOn DateTime   @db.Date
  paymentMethodId String    @db.Uuid
  status         PlanStatus @default(ACTIVE)
  missedCount    Int        @default(0) /// @server
  createdById    String?    @db.Uuid /// @server
  createdAt      DateTime   @default(now()) /// @server
}

/// @tenant
model Statement {
  id            String   @id @default(uuid()) @db.Uuid
  practiceId    String   @db.Uuid /// @server
  patientId     String   @db.Uuid
  patient       Patient  @relation(fields: [patientId], references: [id])
  cycleNumber   Int
  amountDue     Decimal  @db.Decimal(10, 2)
  dueDate       DateTime @db.Date
  channels      String[] /// sms, email, mail, portal
  fileId        String   @db.Uuid
  sentAt        DateTime @default(now())
  openedAt      DateTime?
  paidAt        DateTime?
  holdReason    String?  /// payment-plan, dispute, collections-hold
}

/// Good-faith estimate for self-pay patients
/// @tenant
model Estimate {
  id          String         @id @default(uuid()) @db.Uuid
  practiceId  String         @db.Uuid /// @server
  patientId   String         @db.Uuid
  patient     Patient        @relation(fields: [patientId], references: [id])
  items       Json           /// [{code, description, amount}]
  total       Decimal        @db.Decimal(10, 2) /// @server
  status      EstimateStatus @default(DRAFT)
  fileId      String?        @db.Uuid /// @server
  sentAt      DateTime?      /// @server
  createdById String?        @db.Uuid /// @server
  createdAt   DateTime       @default(now()) /// @server
}

/// Day close: drawer counts vs posted payments vs bank deposit (INV-FIN-04)
/// @tenant
model DepositBatch {
  id            String      @id @default(uuid()) @db.Uuid
  practiceId    String      @db.Uuid /// @server
  businessDate  DateTime    @db.Date
  locationId    String      @db.Uuid
  expected      Json        /// @server totals by user and method
  counted       Json?       /// counts entered at close
  depositTotal  Decimal?    @db.Decimal(12, 2)
  bankMatched   Boolean     @default(false) /// @server
  variance      Decimal     @default(0) @db.Decimal(12, 2) /// @server
  varianceReason String?
  status        BatchStatus @default(OPEN)
  closedById    String?     @db.Uuid /// @server
  closedAt      DateTime?   /// @server

  @@unique([practiceId, locationId, businessDate])
}

// ============================================================================
// PATIENT PORTAL & THIRD-PARTY APPS
// ============================================================================

/// Patient or proxy login (separate identity from staff). Global so a parent can access children at more than one practice.
model PortalUser {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique /// @phi
  phone            String?       /// @phi
  passwordHash     String?       /// @secret
  status           AccountStatus @default(INVITED) /// @server
  emailVerifiedAt  DateTime?     /// @server
  failedLoginCount Int           @default(0) /// @server
  lockedUntil      DateTime?     /// @server
  lastLoginAt      DateTime?     /// @server
  createdAt        DateTime      @default(now()) /// @server

  access           PortalAccess[]
  mfaFactors       MfaFactor[]
}

/// Which patient records a portal user may act for, and with what scope (proxy, adolescent rules OPEN-Q10)
model PortalAccess {
  id            String             @id @default(uuid()) @db.Uuid
  practiceId    String             @db.Uuid /// @server
  portalUserId  String             @db.Uuid
  portalUser    PortalUser         @relation(fields: [portalUserId], references: [id])
  patientId     String             @db.Uuid
  patient       Patient            @relation(fields: [patientId], references: [id])
  relationship  PortalRelationship
  scope         String[]           /// messages, appointments, results, billing, record, notes
  validFrom     DateTime           @default(now())
  validUntil    DateTime?          /// e.g. proxy ends at child's 12th/18th birthday per state rule
  grantedById   String?            @db.Uuid /// @server
  revokedAt     DateTime?

  @@unique([portalUserId, patientId])
}

/// Registered SMART on FHIR client app (patient-access and bulk)
model SmartClient {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @unique
  name            String
  redirectUris    String[]
  scopes          String[]
  confidential    Boolean  @default(false)
  clientSecretHash String? /// @secret
  jwksUri         String?
  backendService  Boolean  @default(false) /// bulk data
  practiceId      String?  @db.Uuid /// null = available to all practices
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  grants          SmartGrant[]
}

/// Patient authorisation of an app (portal.profile#apps)
model SmartGrant {
  id            String      @id @default(uuid()) @db.Uuid
  smartClientId String      @db.Uuid
  smartClient   SmartClient @relation(fields: [smartClientId], references: [id])
  portalUserId  String      @db.Uuid
  patientId     String      @db.Uuid
  scopes        String[]
  grantedAt     DateTime    @default(now())
  lastAccessAt  DateTime?
  revokedAt     DateTime?
}

// ============================================================================
// INTEGRATIONS (ADR-005): connections, message log, webhooks, outbox
// ============================================================================

/// One configured connection per practice and vendor. Secrets live in a secret store; only references here.
/// @tenant
model IntegrationConnection {
  id                  String            @id @default(uuid()) @db.Uuid
  practiceId          String            @db.Uuid /// @server
  kind                IntegrationKind
  gateway             String            /// ClearinghouseGateway, ErxGateway, LabGateway, …
  displayName         String
  config              Json              /// non-secret settings (endpoints, sender ids, facility ids)
  secretRef           String            /// @secret secret-store path
  health              IntegrationHealth @default(HEALTHY) /// @server
  healthSince         DateTime          @default(now()) /// @server
  lastSuccessAt       DateTime?         /// @server
  lastError           String?           /// @server
  certificateExpiresAt DateTime?
  baaOnFile           Boolean           @default(false) /// HIPAA BAA signed with vendor
  enabled             Boolean           @default(true)
  updatedAt           DateTime          @updatedAt /// @server

  messages            InterfaceMessage[]

  @@unique([practiceId, kind])
}

/// Every message to/from an external system. Idempotent retries (INV-OPS-01).
/// @tenant
model InterfaceMessage {
  id             String                 @id @default(uuid()) @db.Uuid
  practiceId     String                 @db.Uuid /// @server
  connectionId   String                 @db.Uuid
  connection     IntegrationConnection  @relation(fields: [connectionId], references: [id])
  direction      InterfaceDirection
  messageType    String                 /// X12_270, X12_837P, X12_835, HL7_ORM, HL7_ORU, HL7_VXU, NCPDP_NEWRX, SMS, EMAIL, …
  idempotencyKey String                 @unique
  status         InterfaceMessageStatus @default(QUEUED)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime?
  payloadFileId  String?                @db.Uuid /// @phi encrypted payload on volume
  vendorRef      String?
  correlationType String?
  correlationId  String?                @db.Uuid
  error          String?
  createdAt      DateTime               @default(now())
  completedAt    DateTime?

  @@index([connectionId, status, nextAttemptAt])
  @@index([correlationType, correlationId])
}

/// Inbound webhook receipts (Stedi, Twilio, LogiCoy, Health Gorilla). Deduplicated by vendor event id.
model WebhookEvent {
  id                String   @id @default(uuid()) @db.Uuid
  practiceId        String?  @db.Uuid
  provider          IntegrationKind
  vendorEventId     String
  signatureVerified Boolean
  payloadFileId     String?  @db.Uuid /// @phi
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  error             String?

  @@unique([provider, vendorEventId])
}

/// Transactional outbox: domain events written in the same transaction, delivered by workers
model OutboxEvent {
  id          BigInt   @id @default(autoincrement())
  practiceId  String?  @db.Uuid
  topic       String   /// appointment.status-changed, order.signed, note.signed, claim.ready, …
  payload     Json     /// ids only; consumers re-read the row
  createdAt   DateTime @default(now())
  dispatchedAt DateTime?
  attempts    Int      @default(0)

  @@index([dispatchedAt, createdAt])
}

/// Async jobs: exports (CSV, bulk FHIR, EHI), statement runs, eligibility batches, measure computation
/// @tenant
model Job {
  id            String     @id @default(uuid()) @db.Uuid
  practiceId    String     @db.Uuid /// @server
  type          String     /// export, statement-run, eligibility-batch, measure-compute, registry-query
  exportType    ExportType?
  params        Json
  status        JobStatus  @default(QUEUED) /// @server
  progress      Int        @default(0) /// @server
  resultFileIds String[]   @db.Uuid /// @server
  error         String?    /// @server
  requestedById String?    @db.Uuid /// @server
  requestedAt   DateTime   @default(now()) /// @server
  finishedAt    DateTime?  /// @server
  expiresAt     DateTime?  /// @server download link expiry
}

// ============================================================================
// REFERENCE DATA (global): ICD-10-CM, CVX, POS, LOINC, CPT/HCPCS, CARC/RARC, NUCC, RxNorm cache, NPPES cache
// ============================================================================

/// Code systems loaded from authoritative sources (CMS ICD-10-CM, CDC CVX, CMS POS, LOINC, X12 CARC/RARC, NUCC).
/// CPT content requires an AMA licence; load only what the practice is licensed for.
/// @reference
model CodeConcept {
  id          String     @id @default(uuid()) @db.Uuid
  system      CodeSystem
  code        String
  display     String
  shortDisplay String?
  active      Boolean    @default(true)
  billable    Boolean?   /// ICD-10-CM leaf codes
  attributes  Json?      /// e.g. CVX status, POS description, laterality hints
  sourceVersion String   /// release, e.g. "ICD-10-CM 2026"
  effectiveFrom DateTime? @db.Date
  effectiveTo DateTime?  @db.Date

  @@unique([system, code, sourceVersion])
  @@index([system, display])
}

/// RxNorm concepts cached from RxNav (drug search, schedules, NDC links)
/// @reference
model RxNormConcept {
  rxcui        String   @id
  name         String
  tty          String   /// SCD, SBD, GPCK, IN, …
  deaSchedule  String?
  ndcs         String[]
  ingredients  String[]
  fetchedAt    DateTime @default(now())

  @@index([name])
}

/// NPPES NPI Registry lookups cached for providers, organisations and referral recipients
/// @reference
model NpiRegistryEntry {
  npi          String   @id
  entityType   String   /// 1 individual, 2 organisation
  name         String
  taxonomies   Json
  addresses    Json
  status       String
  fetchedAt    DateTime @default(now())
}
