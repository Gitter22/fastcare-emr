// Clinic EHR — data model (PostgreSQL)
// Source of truth for persistence. See docs/09-data-model.md (conventions, FHIR mapping) and docs/10-hipaa-controls.md.
//
// Doc-comment tags read by tools/build-openapi.mjs and the validator:
//   model-level  /// @tenant        row carries practiceId; Postgres RLS policy isolates tenants (INV-SEC-02)
//                /// @fhir <Type>    exposed through the FHIR R4 facade as this resource (US Core where one exists)
//                /// @append-only    no UPDATE/DELETE grants for the app role (INV-SEC-01, INV-FIN-01)
//                /// @versioned      every change writes a ResourceVersion row (FHIR _history, vread, audit)
//                /// @reference      global reference data (not tenant-scoped)
//   field-level  /// @phi           contains protected health information
//                /// @encrypted      application-level envelope encryption (KMS data key); ciphertext stored
//                /// @secret         never serialised in any API response
//                /// @server         set by the server only; excluded from create/update request bodies
//
// Status enums mirror spec/states.yaml state ids (upper snake case). Do not add values here without adding the state there.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

