// ============================================================================
// TENANCY & ORGANISATION
// ============================================================================

/// The clinic organisation (one tenant). Global table; all other tenant rows reference Practice.id via practiceId.
/// @fhir Organization (US Core Organization)
/// @versioned
model Practice {
  id             String   @id @default(uuid()) @db.Uuid
  legalName      String
  tin            String   /// Tax ID
  groupNpi       String?  /// Validated against NPPES
  taxonomyCode   String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String   @db.Char(2)
  postalCode     String
  phone          String?
  timezone       String   @default("America/Chicago")
  active         Boolean  @default(true)
  version        Int      @default(1) /// @server
  createdAt      DateTime @default(now()) /// @server
  updatedAt      DateTime @updatedAt /// @server

  locations      Location[]
  settings       PracticeSetting[]
}

/// Key/value practice configuration (security policy, portal settings, wait targets, booking rules, SLAs). Versioned.
/// @tenant
/// @versioned
model PracticeSetting {
  id          String   @id @default(uuid()) @db.Uuid
  practiceId  String   @db.Uuid /// @server
  practice    Practice @relation(fields: [practiceId], references: [id])
  key         String   /// e.g. security.sessionTimeoutMinutes, portal.resultReleasePolicy, schedule.waitTargetMinutes
  value       Json
  version     Int      @default(1) /// @server
  updatedAt   DateTime @updatedAt /// @server
  updatedById String?  @db.Uuid /// @server

  @@unique([practiceId, key])
}

/// @tenant
/// @fhir Location (US Core Location)
/// @versioned
model Location {
  id              String   @id @default(uuid()) @db.Uuid
  practiceId      String   @db.Uuid /// @server
  practice        Practice @relation(fields: [practiceId], references: [id])
  name            String
  npi             String?  /// Facility NPI (NPPES)
  placeOfService  String   /// CMS POS code (CodeConcept POS), e.g. "11"
  addressLine1    String
  addressLine2    String?
  city            String
  state           String   @db.Char(2)
  postalCode      String
  phone           String?
  fax             String?
  hours           Json?    /// weekly opening hours
  active          Boolean  @default(true)
  version         Int      @default(1) /// @server
  createdAt       DateTime @default(now()) /// @server
  updatedAt       DateTime @updatedAt /// @server

  rooms           Room[]
  appointments    Appointment[]
  encounters      Encounter[]

  @@index([practiceId])
}

/// @tenant
model Room {
  id          String     @id @default(uuid()) @db.Uuid
  practiceId  String     @db.Uuid /// @server
  locationId  String     @db.Uuid
  location    Location   @relation(fields: [locationId], references: [id])
  name        String
  status      RoomStatus @default(READY)
  equipment   String[]
  isVirtual   Boolean    @default(false)
  active      Boolean    @default(true)
  updatedAt   DateTime   @updatedAt /// @server

  appointments Appointment[]

  @@index([practiceId, locationId])
}

/// Clinician record (licensing, NPI, DEA, EPCS). Linked 1:1 to a staff User when the clinician signs in.
/// @tenant
/// @fhir Practitioner (US Core Practitioner)
/// @versioned
model Practitioner {
  id                  String   @id @default(uuid()) @db.Uuid
  practiceId          String   @db.Uuid /// @server
  userId              String?  @unique @db.Uuid
  user                User?    @relation(fields: [userId], references: [id])
  firstName           String
  lastName            String
  credential          String?  /// MD, DO, NP, PA, RN, MA
  npi                 String?  /// Individual NPI, validated against NPPES
  taxonomyCode        String?  /// NUCC taxonomy
  supervisingId       String?  @db.Uuid
  supervising         Practitioner?  @relation("Supervision", fields: [supervisingId], references: [id])
  supervisees         Practitioner[] @relation("Supervision")
  epcsProofedAt       DateTime? /// identity proofing completed for EPCS
  epcsEnabled         Boolean  @default(false) /// @server
  isBillingProvider   Boolean  @default(true)
  active              Boolean  @default(true)
  version             Int      @default(1) /// @server
  createdAt           DateTime @default(now()) /// @server
  updatedAt           DateTime @updatedAt /// @server

  licenses            PractitionerLicense[]
  deaRegistrations    DeaRegistration[]
  payerEnrollments    PayerEnrollment[]
  appointments        Appointment[]
  encounters          Encounter[]
  scheduleTemplates   ScheduleTemplate[]

  @@index([practiceId])
  @@index([npi])
}

/// @tenant
model PractitionerLicense {
  id              String       @id @default(uuid()) @db.Uuid
  practiceId      String       @db.Uuid /// @server
  practitionerId  String       @db.Uuid
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id])
  state           String       @db.Char(2)
  number          String
  type            String
  expiresOn       DateTime     @db.Date
}

/// @tenant
model DeaRegistration {
  id              String       @id @default(uuid()) @db.Uuid
  practiceId      String       @db.Uuid /// @server
  practitionerId  String       @db.Uuid
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id])
  number          String       /// @encrypted
  state           String       @db.Char(2)
  schedules       String[]     /// e.g. ["2","2N","3","4","5"]
  expiresOn       DateTime     @db.Date
}

/// Payer enrolment status per provider (credentialing)
/// @tenant
model PayerEnrollment {
  id              String       @id @default(uuid()) @db.Uuid
  practiceId      String       @db.Uuid /// @server
  practitionerId  String       @db.Uuid
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id])
  payerId         String       @db.Uuid
  payer           Payer        @relation(fields: [payerId], references: [id])
  status          String       /// pending, enrolled, terminated
  effectiveFrom   DateTime?    @db.Date
}

/// Team queue that tasks route to (care team, billing pool, front desk pool)
/// @tenant
/// @fhir CareTeam
model WorkPool {
  id          String   @id @default(uuid()) @db.Uuid
  practiceId  String   @db.Uuid /// @server
  name        String
  kind        String   /// care-team, billing, front-desk, referrals
  slaHours    Int?     /// default due time for routed tasks
  active      Boolean  @default(true)
  members     WorkPoolMember[]
  tasks       Task[]
  threads     MessageThread[]

  @@index([practiceId])
}

/// @tenant
model WorkPoolMember {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @db.Uuid /// @server
  poolId     String   @db.Uuid
  pool       WorkPool @relation(fields: [poolId], references: [id])
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])

  @@unique([poolId, userId])
}

// ============================================================================
// IDENTITY, AUTHENTICATION & ACCESS CONTROL (HIPAA §164.312(a),(d))
// ============================================================================

/// Staff account. MFA is mandatory (INV-SEC-04).
/// @tenant
model User {
  id                 String        @id @default(uuid()) @db.Uuid
  practiceId         String        @db.Uuid /// @server
  email              String
  firstName          String
  lastName           String
  phone              String?       /// for SMS MFA
  status             AccountStatus @default(INVITED) /// @server
  passwordHash       String?       /// @secret argon2id
  passwordChangedAt  DateTime?     /// @server
  failedLoginCount   Int           @default(0) /// @server
  lockedUntil        DateTime?     /// @server
  lastLoginAt        DateTime?     /// @server
  mfaEnrolledAt      DateTime?     /// @server
  activeRole         Role?         /// role currently acting as (user may hold several)
  deactivatedAt      DateTime?     /// @server
  version            Int           @default(1) /// @server
  createdAt          DateTime      @default(now()) /// @server
  updatedAt          DateTime      @updatedAt /// @server

  roles              UserRole[]
  locations          UserLocation[]
  mfaFactors         MfaFactor[]
  practitioner       Practitioner?
  poolMemberships    WorkPoolMember[]
  notifications      Notification[]
  emergencyAccess    EmergencyAccessGrant[]

  @@unique([practiceId, email])
}

/// @tenant
model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @db.Uuid /// @server
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  role       Role
  grantedById String? @db.Uuid /// @server
  grantedAt  DateTime @default(now()) /// @server

  @@unique([userId, role])
}

/// @tenant
model UserLocation {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid /// @server
  userId     String @db.Uuid
  user       User   @relation(fields: [userId], references: [id])
  locationId String @db.Uuid

  @@unique([userId, locationId])
}

/// Co-sign rules per provider and item type (ADR-003, OPEN-Q5). Config, not code.
/// @tenant
model CosignRule {
  id              String   @id @default(uuid()) @db.Uuid
  practiceId      String   @db.Uuid /// @server
  practitionerId  String   @db.Uuid /// supervised clinician
  supervisorId    String   @db.Uuid
  appliesTo       String[] /// note, order, prescription; with conditions in criteria
  criteria        Json?    /// e.g. {"newPatient": true, "controlled": true}
  state           String?  @db.Char(2)
  active          Boolean  @default(true)
}

/// MFA factor for staff or portal accounts. Secrets encrypted.
model MfaFactor {
  id            String        @id @default(uuid()) @db.Uuid
  practiceId    String?       @db.Uuid /// @server null for portal users spanning practices
  userId        String?       @db.Uuid
  user          User?         @relation(fields: [userId], references: [id])
  portalUserId  String?       @db.Uuid
  portalUser    PortalUser?   @relation(fields: [portalUserId], references: [id])
  type          MfaFactorType
  label         String?
  secret        Bytes?        /// @secret @encrypted TOTP seed or provider reference
  webauthnCredentialId String? /// @secret
  webauthnPublicKey    Bytes?  /// @secret
  phone         String?       /// for SMS
  verifiedAt    DateTime?     /// @server
  lastUsedAt    DateTime?     /// @server
  createdAt     DateTime      @default(now()) /// @server
}

/// Refresh-token session. Access tokens are short-lived JWTs; this row allows revocation and idle timeout (INV-SEC-04).
model Session {
  id               String         @id @default(uuid()) @db.Uuid
  practiceId       String?        @db.Uuid /// @server
  subject          SessionSubject
  userId           String?        @db.Uuid
  portalUserId     String?        @db.Uuid
  smartClientId    String?        @db.Uuid
  refreshTokenHash String         @unique /// @secret
  mfaVerifiedAt    DateTime?
  stepUpAt         DateTime?      /// last re-authentication (signing, EPCS, exports)
  activeRole       Role?
  ip               String?
  userAgent        String?
  createdAt        DateTime       @default(now())
  lastSeenAt       DateTime       @default(now())
  idleExpiresAt    DateTime
  absoluteExpiresAt DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId])
  @@index([portalUserId])
}

/// Short-lived MFA challenge after password verification
model MfaChallenge {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  portalUserId String?       @db.Uuid
  factorId     String?       @db.Uuid
  type         MfaFactorType
  codeHash     String?       /// @secret
  attempts     Int           @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime      @default(now())
}

/// Login attempts (success and failure) for lockout and security monitoring
model LoginAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  practiceId   String?  @db.Uuid
  email        String
  subject      SessionSubject
  success      Boolean
  reason       String?
  ip           String?
  userAgent    String?
  at           DateTime @default(now())

  @@index([email, at])
}

/// Password reset and invitation tokens (single use)
model AccountToken {
  id           String   @id @default(uuid()) @db.Uuid
  purpose      String   /// invite, password-reset, email-verify, portal-invite
  userId       String?  @db.Uuid
  portalUserId String?  @db.Uuid
  patientId    String?  @db.Uuid /// portal invitation target
  tokenHash    String   @unique /// @secret
  expiresAt    DateTime
  usedAt       DateTime?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
}

/// Time-limited access to restricted records with a recorded reason (INV-SEC-03)
/// @tenant
/// @append-only
model EmergencyAccessGrant {
  id           String            @id @default(uuid()) @db.Uuid
  practiceId   String            @db.Uuid /// @server
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id])
  patientId    String            @db.Uuid
  patient      Patient           @relation(fields: [patientId], references: [id])
  reasonCode   String            /// emergency, treatment-continuity, other
  reasonText   String            /// @phi
  scope        String[]          /// security labels unlocked, e.g. ["R","42CFRPart2"]
  grantedAt    DateTime          @default(now())
  expiresAt    DateTime
  reviewOutcome BreakGlassOutcome @default(PENDING_REVIEW)
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([practiceId, reviewOutcome])
}

// ============================================================================
// AUDIT, PROVENANCE, VERSION HISTORY (HIPAA §164.312(b), INV-SEC-01)
// ============================================================================

/// Every read and write of PHI. Append-only, hash-chained for tamper evidence.
/// @tenant
/// @append-only
/// @fhir AuditEvent
model AuditEvent {
  id            BigInt       @id @default(autoincrement())
  practiceId    String?      @db.Uuid
  at            DateTime     @default(now())
  actorType     String       /// staff, portal, smart-app, system, integration
  actorId       String?      @db.Uuid
  actorRole     Role?
  onBehalfOfPatientId String? @db.Uuid /// proxy access
  action        AuditAction
  outcome       AuditOutcome @default(SUCCESS)
  patientId     String?      @db.Uuid
  resourceType  String?
  resourceId    String?
  operationId   String?      /// OpenAPI operationId or FHIR interaction
  purposeOfUse  String?      /// TREAT, HPAYMT, HOPERAT, ETREAT (break-glass), PATRQT
  emergencyAccessId String?  @db.Uuid
  ip            String?
  userAgent     String?
  sessionId     String?      @db.Uuid
  detail        Json?        /// non-PHI detail: fields changed (names only), query params hashed
  prevHash      String?
  hash          String

  @@index([practiceId, at])
  @@index([patientId, at])
  @@index([actorId, at])
}

/// Accounting of disclosures outside treatment/payment/operations (HIPAA §164.528)
/// @tenant
/// @append-only
model DisclosureLog {
  id            String            @id @default(uuid()) @db.Uuid
  practiceId    String            @db.Uuid /// @server
  patientId     String            @db.Uuid
  patient       Patient           @relation(fields: [patientId], references: [id])
  disclosedAt   DateTime          @default(now())
  recipient     String
  purpose       DisclosurePurpose
  description   String            /// what was disclosed
  method        String            /// fax, mail, portal, api
  authorizationConsentId String?  @db.Uuid
  recordedById  String            @db.Uuid /// @server
}

/// Full snapshot per change of any @versioned model. Serves FHIR vread/_history, audit diffs and EHI export.
/// @tenant
/// @append-only
model ResourceVersion {
  id            BigInt   @id @default(autoincrement())
  practiceId    String?  @db.Uuid
  resourceType  String
  resourceId    String   @db.Uuid
  version       Int
  snapshot      Json     /// @phi @encrypted
  changedById   String?  @db.Uuid
  changedAt     DateTime @default(now())
  changeReason  String?

  @@unique([resourceType, resourceId, version])
}

/// Origin of a clinical fact (ADR-002, INV-DATA-01)
/// @tenant
/// @append-only
/// @fhir Provenance (US Core Provenance)
model ProvenanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  practiceId    String           @db.Uuid /// @server
  targetType    String
  targetId      String           @db.Uuid
  source        ProvenanceSource
  activity      String           /// create, update, reconcile-accept, reconcile-reject, ai-accept
  agentType     String           /// user, patient, organization, device, ai-model
  agentId       String?
  agentDisplay  String?
  sourceDocumentId String?       @db.Uuid
  recordedAt    DateTime         @default(now())

  @@index([targetType, targetId])
}

// ============================================================================
// FILES (Docker volume storage, encrypted at rest)
// ============================================================================

/// Binary stored on the mounted Docker volume under storageKey, encrypted with a per-file data key.
/// @tenant
model FileObject {
  id            String   @id @default(uuid()) @db.Uuid
  practiceId    String   @db.Uuid /// @server
  storageKey    String   @unique /// @server path relative to the volume root; never derived from user input
  fileName      String   /// @phi
  contentType   String
  sizeBytes     Int
  sha256        String   /// @server
  encryptionKeyId String /// @server KMS key reference for the wrapped data key
  wrappedDataKey Bytes   /// @secret
  pageCount     Int?
  uploadedById  String?  @db.Uuid /// @server
  uploadedByPortalUserId String? @db.Uuid /// @server
  createdAt     DateTime @default(now()) /// @server
  deletedAt     DateTime? /// @server retention-driven purge marker
}

