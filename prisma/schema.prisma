/// @tenant
model PatientContactPoint {
  id         String             @id @default(uuid()) @db.Uuid
  practiceId String             @db.Uuid /// @server
  patientId  String             @db.Uuid
  patient    Patient            @relation(fields: [patientId], references: [id])
  system     ContactPointSystem
